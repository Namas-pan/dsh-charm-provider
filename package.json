{
  "name": "dsh-charm-provider",
  "version": "0.2.1",
  "description": "Charm Hyper (hyper.charm.land) LLM provider plugin for DeepSeek Harness: live model catalog, image input, reasoning effort, and per-request cost readout.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "provider",
    "llm",
    "adapter",
    "hyper",
    "charm",
    "openai-compatible"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Namas-pan/dsh-charm-provider.git"
  },
  "homepage": "https://github.com/Namas-pan/dsh-charm-provider#readme",
  "bugs": {
    "url": "https://github.com/Namas-pan/dsh-charm-provider/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.1.5-rc.2": "compatible"
      },
      "dsh": "^0.1.5-rc.2"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": ">=0.1.5-rc.2 <2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2 <2",
    "@deepseek-ai/dsh-settings": ">=0.1.5-rc.2 <2",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.5-rc.2 <2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-credentials": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-settings": { "optional": true },
    "@deepseek-ai/dsh-typert-protocol": { "optional": true },
    "@deepseek-ai/schemastery": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.5-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs --check",
    "verify": "node scripts/verify-plugin.mjs && node scripts/verify-client.mjs",
    "verify:live": "node scripts/verify-live.mjs",
    "check": "node scripts/build.mjs --check && node scripts/verify-plugin.mjs && node scripts/verify-client.mjs",
    "prepublishOnly": "node scripts/build.mjs",
    "install:profile": "node scripts/install.mjs"
  }
}